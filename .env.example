DATABASE_URL=postgres://user:pass@localhost:5432/elitecoach
JWT_SECRET=change-me-to-32-chars-minimum-secret
PORT=8080
FRONTEND_URL=http://localhost:5173
APP_ENV=development
ANTHROPIC_API_KEY=sk-ant-...

# Resend — sends the magic-link email. Required when APP_ENV != development
# (the server refuses to start without it: no email means nobody can log in).
# In development it's optional; leave it unset and the login flow falls back to
# the devToken returned by POST /api/auth/magic-link.
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend. The default,
# "ELITE <onboarding@resend.dev>", needs no verification but only delivers to
# the address that owns the Resend account — fine for local testing.
EMAIL_FROM=ELITE <no-reply@yourdomain.com>

# Public URL of THIS backend. Used to build the OAuth redirect_uri, which must
# match what you register with each provider character for character.
# Defaults to http://localhost:$PORT.
API_URL=http://localhost:8080

# Set to "true" ONLY when the backend sits behind Cloudflare (tunnel or proxy).
# The magic-link rate limiter keys on the client IP, so getting this wrong
# breaks it: "true" while directly exposed lets anyone bypass the limit with a
# forged header; "false" behind the tunnel makes every request look like one IP,
# so users lock each other out.
# Only CF-Connecting-IP is trusted — X-Forwarded-For and True-Client-IP are
# client-forgeable even through Cloudflare, so they are stripped on arrival.
TRUST_PROXY_HEADERS=false

# Directory holding the built SPA (the `build/` output of `pnpm build`). When
# set, the binary serves the frontend on the same origin as the API — which is
# what removes CORS from the picture and makes the OAuth redirect_uri match the
# public domain. Leave unset in development: vite serves the frontend on :5173
# and CORS is enabled against FRONTEND_URL instead.
# The Docker image sets this to /app/static.
STATIC_DIR=

# --- Admin panel ---
# The management panel is server-rendered by this same binary at /admin.
#
# The first administrator, created at startup ONLY when the `admins` table is
# empty. Every other administrator is then created from inside the panel —
# there is no sign-up: unlike the athlete app, typing an address into a form
# never creates an account here.
#
# Leaving this set after the first boot is harmless: the condition is "table is
# empty", not "this address is missing", so an administrator you disabled from
# the panel does not come back on the next restart.
ADMIN_BOOTSTRAP_EMAIL=

# --- OAuth: Google (optional) ---
# Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: $API_URL/api/auth/oauth/google/callback
# Both values must be set or the Google button is not shown.
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- OAuth: Apple (optional) ---
# Needs an Apple Developer Program membership. Create an App ID with "Sign in
# with Apple", then a Services ID, then a key — download the .p8 once.
# Redirect URI: $API_URL/api/auth/oauth/apple/callback
# NOTE: Apple rejects http:// and localhost redirect URIs, so this flow cannot
# be tested locally — use a tunnel (cloudflared/ngrok) or a deployed host.
# All four must be set or the Apple button is not shown.
APPLE_TEAM_ID=ABCDE12345
APPLE_SERVICES_ID=com.yourdomain.elite.web
APPLE_KEY_ID=ABCD123456
# Contents of the .p8 file. Newlines may be written literally as \n.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
